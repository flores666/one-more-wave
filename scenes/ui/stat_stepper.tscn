[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/stat_stepper.gd" id="1"]

[node name="StatStepper" type="HBoxContainer"]
theme_override_constants/separation = 2
script = ExtResource("1")

[node name="Name" type="Label" parent="."]
custom_minimum_size = Vector2(16, 0)
layout_mode = 2
text = "STR"

[node name="Minus" type="Button" parent="."]
layout_mode = 2
focus_mode = 0
text = "-"

[node name="Value" type="Label" parent="."]
custom_minimum_size = Vector2(12, 0)
layout_mode = 2
text = "0"
horizontal_alignment = 1

[node name="Plus" type="Button" parent="."]
layout_mode = 2
focus_mode = 0
text = "+"

[connection signal="pressed" from="Minus" to="." method="_on_minus_pressed"]
[connection signal="pressed" from="Plus" to="." method="_on_plus_pressed"]
