; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="One More Wave"
run/main_scene="res://scenes/class_select.tscn"
config/features=PackedStringArray("4.7")

[autoload]

DevSettings="*res://scripts/dev_settings.gd"
DevTools="*res://scenes/dev_tools.tscn"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="Athene"

[gui]

theme/custom="res://resources/ui_theme.tres"

